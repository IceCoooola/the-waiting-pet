--- !u!114 &1171940195
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1171940192}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 666e90e57ded125498f138b5c6fd81cf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiaryInteraction
  darkDialogueTexts:
  - 'A worn diary... Did my owner write this? Why is in on the floor?

    (Press
    Space to continue.)'
  - 'I can''t read it. The room is too dark.

    (Press Space to continue.)'
  - 'Maybe I need some kind of light..

    (Press Space to continue.)'
  readableDialogueTexts:
  - 'October 31

    The bottle behaved differently during today''s test.

    I
    should continue working near the tank.

    (Press Space to continue.)'
  - 'November 4

    I looked over the table.

    Why does the table seem far away?

    (Press
    Space to continue.)'
  - 'November 6

    I dropped my pen twice today.

    My hands have felt strangely
    clumsy lately.

    (Press Space to continue.)'
  - 'November 7

    They resemble footsteps. The wider side is the direction I move
    toward.

    (Press Space to continue.)'
  carpet: {fileID: 1187910697}
  footprints:
  - {fileID: 821304387}
  - {fileID: 153433477}
  - {fileID: 56079965}
  - {fileID: 433975862}
  audioSource: {fileID: 0}
  pageTurnClip: {fileID: 0}
  hintDelay: 180
  puzzleHintDialogue: 'I noticed something about the objects on the table.

    One
    side is noticeably larger than the other.

    The wider side always seems to
    lead.'
  puzzleRewardKey: {fileID: 0}
