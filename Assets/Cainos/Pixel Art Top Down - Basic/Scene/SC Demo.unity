  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74df5be4beba14603a3638b7e5f7732e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrystalBallDialogue
  itemId: MagicWand
  dependencies:
  - {fileID: 2039120007}
  - {fileID: 1758604457}
  - {fileID: 1704086164}
  prePickupDialogue: I saw something in the crystal ball.... I can't see it clearly....
    seems like a MagicWand
  lockedDialogue: I have the wand, but the crystal ball remains foggy... I feel like
    I need to recall my other memories first.
  postPickupDialogues:
  - I remember I was the witch!
  - 'The villagers drove me from my home.

    I didn''t know if I''d ever come back.'
  - So I brewed a shapeshift potion to hide myself...
  - 'But something went wrong.

    I drank it too quickly, and lost everything I
    knew.'
  witchSpawnPoint: {fileID: 1851340503}
  triggerTransformation: 1
  roomToDisable: {fileID: 2035825759}
  roomToEnable: {fileID: 983159612}
  glowColor: {r: 0.2, g: 0.8, b: 1, a: 1}
  pulseSpeed: 5
  scalePulseAmount: 0.2
