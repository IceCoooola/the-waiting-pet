  m_Script: {fileID: 11500000, guid: 74df5be4beba14603a3638b7e5f7732e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CrystalBallDialogue
  itemId: Seagrass
  dependencies: []
  prePickupDialogue: I saw something in the crystal ball... I can't see it clearly...
    seems like a Seagrass
  lockedDialogue: The mist inside won't clear... I feel like I'm missing something
    important.
  postPickupDialogues:
  - I remember I was a small fish...
  - I swam through narrow pipes and into the vast ocean...
